DATABASE_URL=postgresql://beacom:CHANGEZ_MOI@localhost:5432/db_collecte
JWT_SECRET=CHANGEZ_MOI_AVEC_UNE_VALEUR_ALEATOIRE_DE_64_CARACTERES
ALLOWED_ORIGINS=http://localhost:3000
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
QUEUE_NAME=avis-a-analyser
# URL de service-etablissements, pour vérifier qu'un établissement existe avant d'enregistrer un avis
ETABLISSEMENTS_API_URL=http://localhost:8001
# Clé partagée avec l'Azure Function (route PATCH /avis/{id}/statut)
INTERNAL_API_KEY=CHANGEZ_MOI_CLE_INTERNE_ALEATOIRE
# URL de service-utilisateurs : plan de l'organisation pour un avis déposé par le lien public
UTILISATEURS_API_URL=http://localhost:8000
# Nombre de proxys de confiance devant le service (1 : frontal App Service ; 2 : derrière la passerelle Next.js)
PROXIES_DE_CONFIANCE=1
# Facultatif : Application Insights (télémétrie désactivée si vide)
APPLICATIONINSIGHTS_CONNECTION_STRING=
