DATABASE_URL=postgresql://beacom:CHANGEZ_MOI@localhost:5432/db_utilisateurs
# Au moins 32 caractères aléatoires, identique dans les 4 services (ex. : openssl rand -hex 32)
JWT_SECRET=CHANGEZ_MOI_AVEC_UNE_VALEUR_ALEATOIRE_DE_64_CARACTERES
JWT_EXPIRE_MINUTES=60
# Facultatif : compte de démonstration créé au démarrage si cet e-mail n'existe pas encore,
# dans une organisation au plan entreprise. Les clients, eux, s'inscrivent par POST /auth/inscription.
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_LONG
ADMIN_ORGANISATION=Beacom (démonstration)
# Origines du frontend autorisées (CORS), séparées par des virgules
ALLOWED_ORIGINS=http://localhost:3000
# Clé partagée avec service-collecte et la Function (routes /interne/...)
INTERNAL_API_KEY=CHANGEZ_MOI_CLE_INTERNE_ALEATOIRE
# Nombre de proxys de confiance devant le service (1 : frontal App Service ; 2 : derrière la passerelle Next.js)
PROXIES_DE_CONFIANCE=1
# Facultatif : Application Insights (télémétrie désactivée si vide)
APPLICATIONINSIGHTS_CONNECTION_STRING=
